# Example environment variables for SOP deployments
# Copy this file to .env or inject these values into your runtime environment.

SOP_SYSTEM_ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
SOP_SESSION_SECRET=replace-with-a-long-random-session-secret
SOP_CONFIG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
